# Copy to .env (or export directly) before running `ai-review pr`.

# Required for real (non-dry-run) LLM calls. Used in src/ai_review/llm/client.py.
ANTHROPIC_API_KEY=

# Required for `ai-review pr` always, even in --dry-run mode (it still reads
# the PR and, unless --no-post, writes the summary comment). Used in
# src/ai_review/cli.py. In CI via GitHub Actions this is provided automatically
# as github.token — see action.yml.
GITHUB_TOKEN=
